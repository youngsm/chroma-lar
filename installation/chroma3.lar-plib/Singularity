Bootstrap: docker
From: pytorch/pytorch:2.5.1-cuda12.4-cudnn9-devel

# Build: apptainer build --fakeroot [--build-arg CHROMA_LAR_REF=<branch>] chroma-lar.sif Singularity
%arguments
    CHROMA_LAR_REF=main

%post
    apt-get update && apt-get install -y \
        git \
        wget \
        build-essential \
        libgl1-mesa-dev \
        libglu1-mesa-dev \
        freeglut3-dev \
        libglew-dev \
        libglfw3-dev \
        libegl1-mesa-dev \
        libgbm-dev \
        libgles2-mesa-dev \
        mesa-utils \
        libvulkan1 \
        mesa-vulkan-drivers \
        libx11-dev \
        libxcursor-dev \
        libxi-dev \
        libxinerama-dev \
        libxrandr-dev  \
        mesa-common-dev \
        xorg-dev \
        && rm -rf /var/lib/apt/lists/*

    /opt/conda/bin/python -m pip install --no-cache-dir uv==0.11.28
    export UV_CACHE_DIR=/tmp/uv-cache
    mkdir -p /workspace && cd /workspace
    git clone --branch {{ CHROMA_LAR_REF }} https://github.com/youngsm/chroma-lar
    # chroma-lar, TriChroma (Chroma + its Triton backend) and photonlib; no PyCUDA.
    # Run from the checkout so uv reads its [tool.uv] settings (photonlib's build dependency).
    cd /workspace/chroma-lar && uv pip install --python /opt/conda/bin/python -e . && cd /workspace
    # analysis extras
    uv pip install --python /opt/conda/bin/python scikit-learn gdown \
        git+https://github.com/CIDeR-ML/siren-lartpc.git \
        git+https://github.com/CIDeR-ML/sirentv.git
    rm -rf /tmp/uv-cache

%environment
    export PYRAT_ROOT=/workspace/chroma-lar
    export PATH=/workspace/chroma-lar:$PATH
    # $HOME is bound into the container: keep ~/.local installs from shadowing the image's packages
    export PYTHONNOUSERSITE=1
    #For jupyter
    export PORT=8888

%startscript
    /bin/bash -l
